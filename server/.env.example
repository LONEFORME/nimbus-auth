# 运行环境：development | test | production
NODE_ENV=development

# API 端口
PORT=4000

# SQLite 数据库文件（相对 prisma/schema.prisma 所在目录）
DATABASE_URL="file:./dev.db"

# 访问令牌签名密钥，至少 32 位。生产环境务必替换为随机值：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=please-change-me-to-a-random-32-plus-char-secret

# 访问令牌有效期（分钟）
ACCESS_TOKEN_TTL_MINUTES=15

# 刷新令牌有效期（天）
REFRESH_TOKEN_TTL_DAYS=30

# 允许跨域的前端地址（生产环境改成真实域名）
CLIENT_ORIGIN=http://localhost:5173

# 日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# 密码哈希强度（bcrypt cost）
BCRYPT_ROUNDS=11

# 种子管理员账号
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=管理员
